# ─────────────────────────────────────────────────────────────
# PulseDesk AI — environment variables
# Copy to .env.local for local dev; set the same in Vercel for prod.
# NEVER commit real secrets. NEXT_PUBLIC_* are exposed to the browser
# and inlined at BUILD time (a redeploy is required after changing them);
# everything else is server-only and read at runtime.
# ─────────────────────────────────────────────────────────────

# ── Public app URL (used to point Vapi's serverUrl back at our webhook)
APP_URL=https://pulsedesk-ai.vercel.app
NEXT_PUBLIC_APP_URL=https://pulsedesk-ai.vercel.app

# ── Database + Auth (REQUIRED) — Supabase. Public keys, safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: lets the Vapi webhook write across tenants (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI engine (this phase) ────────────────────────────────────
# LLM. Used by our webhook for post-call transcript extraction; ALSO add this
# same key inside the Vapi dashboard (Provider Keys) for the live conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vapi — orchestrates the live call and calls our webhook.
VAPI_API_KEY=              # REST key to create/manage assistants (server-only)
VAPI_WEBHOOK_SECRET=       # any long random string; we verify inbound webhooks with it
VAPI_PHONE_NUMBER_ID=      # optional: attach an existing Vapi phone number to new assistants

# ── Telephony / voice / calendar (later phases) ───────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=          # optional STT (Vapi has a default)
ELEVENLABS_API_KEY=        # optional TTS (Vapi has a default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pulsedesk-ai.vercel.app/api/google/callback

# ── Post-call automation (optional / on hold) — n8n
N8N_WEBHOOK_URL=
