# ─────────────────────────────────────────────────────────────
# PulseDesk AI — Environment variables (Spec §8.2 / §11)
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Telephony (REQUIRED) — Twilio: receives & routes the live call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Voice orchestration (REQUIRED) — Vapi: the live-call "brain"
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ── LLM (REQUIRED — at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Speech (optional, improves quality / cost)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Calendar (REQUIRED for live booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── Database + Auth (REQUIRED) — Supabase (Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (REQUIRED for self-serve billing) — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Automation — n8n (self-hosted on VPS), post-call webhook target
N8N_WEBHOOK_URL=
